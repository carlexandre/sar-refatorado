# Configuração não secreta; o processo recebe estas variáveis do serviço.
# Este arquivo NÃO é carregado automaticamente.
SAR_DATA_DIR=/var/lib/sar
SAR_ACCESS_MODE=internal_team
SAR_ZABBIX_URL=https://zabbix.example.org
SAR_CA_BUNDLE=/etc/sar/ca-bundle.crt
# Credenciais fornecidas pelo systemd: zabbix-token OU zabbix-user e zabbix-password
# Também fornecer gmail-app-password para os workers.
# CREDENTIALS_DIRECTORY é preenchida pelo systemd. Nunca configure senha neste arquivo.
SAR_SMTP_HOST=smtp.gmail.com
SAR_SMTP_PORT=587
SAR_SMTP_TLS=starttls
SAR_SMTP_USER=svc.popce@gmail.com
SAR_MAIL_FROM=svc.popce@gmail.com
SAR_MAIL_TO=svc.popce@rnp.br
SAR_TIMEZONE=America/Fortaleza
