[Unit]
Description=SAR scheduled execution %i
After=network-online.target

[Service]
Type=oneshot
User=sar
Group=sar
WorkingDirectory=/opt/sar
EnvironmentFile=/etc/sar/sar.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MPLCONFIGDIR=/var/lib/sar/matplotlib
LoadCredential=zabbix-token:/etc/sar/credentials/zabbix-token
# Ubuntu 22/systemd 249: arquivo root:root 0600, fora do código e sar.env.
LoadCredential=gmail-app-password:/etc/sar/credentials/gmail-app-password
ExecStart=/opt/sar/.venv/bin/sar run-schedule --id %i
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sar
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
StandardOutput=journal
StandardError=journal
